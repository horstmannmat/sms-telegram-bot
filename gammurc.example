# Copy to /etc/gammurc (or another path) and pass it to gammu-smsd -c, or set
# GAMMU_CONFIG_FILE in systemd. Gammu does not load this filename automatically.

[gammu]
# install.sh prefers a persistent /dev/serial/by-id/... symlink (with Huawei
# if02 PCUI port preference) so USB re-enumeration does not break the path.
# Falls back to gammu-detect or /dev/ttyUSB* / /dev/ttyACM*.
device = /dev/ttyUSB0
name = HUAWEI
connection = at

[smsd]
# SMSD service to use, one of FILES, MYSQL, PGSQL, DBI
service = files
# PIN for SIM card (uncomment and set if your SIM requires it)
# pin = 1234
# File (or stderr, syslog, eventlog) where information will be logged.
# install.sh --user sets <repo>/log/gammu-smsd.log; system mode sets syslog.
logfile = smsdlog
# Amount of information being logged, each bit mean one level
debuglevel = 0
# gammu-smsd runs: PROGRAM [args...] — then appends the new SMS filename (under inboxpath).
# Use --log for sms.py file logging; omit --log for stderr only. Gammu appends the SMS path last.
runonreceive = /path/to/home/sms-telegram-bot/.venv/bin/python /path/to/home/sms-telegram-bot/src/sms.py --log /path/to/home/sms-telegram-bot/log/sms.log /path/to/home/sms-telegram-bot/config.pkl
# Communication frequency settings
commtimeout = 30
sendtimeout = 30
# Optional periodic preventive soft reset in seconds (0 = disabled).
# resetfrequency = 86400

inboxpath = /path/to/home/sms/inbox/
outboxpath = /path/to/home/sms/outbox/
sentsmspath = /path/to/home/sms/sent/
errorsmspath  = /path/to/home/sms/error/
# detail merges multipart SMS into one file (standard emits one file per part)
inboxformat = detail
#outboxformat = detail
