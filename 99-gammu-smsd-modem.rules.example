# Disable USB autosuspend for the modem and restart gammu-smsd when the modem
# serial interface re-enumerates (prevents gammu-smsd from staying wedged on a
# stale /dev/ttyUSB* file descriptor after a USB disconnect/reset).
#
# Generated by install.sh from 99-gammu-smsd-modem.rules.example.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="__VID__", ATTR{idProduct}=="__PID__", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="tty", ATTRS{idVendor}=="__VID__", ATTRS{idProduct}=="__PID__"__IF_MATCH__, RUN+="__RESTART_CMD__"
